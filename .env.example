# ── Microsoft Foundry Local ────────────────────────────────────────────────────
# Start Foundry Local before running the backend: `foundry service start`
FOUNDRY_BASE_URL=http://localhost:5273/v1
FOUNDRY_API_KEY=foundry
FOUNDRY_LLM_MODEL=Phi-4-mini-instruct-cuda-gpu:5
FOUNDRY_EMBEDDING_MODEL=qwen3-embedding-0.6b   # KULLANILMIYOR: Foundry Local kataloğunda embedding modeli yok. Embedding sentence-transformers ile çalışır.

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=destinations

# ── SQLite ─────────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/cartena.db

# ── Knowledge Base ─────────────────────────────────────────────────────────────
KB_DATA_PATH=./backend/data/kb/destinations.json

# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# ── CORS (frontend dev server) ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
